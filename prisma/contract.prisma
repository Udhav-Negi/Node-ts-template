// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @onUpdate(now())
}

model Url {
  id     Int    @id @default(autoincrement())
  url    String
  userid Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @onUpdate(now())

  @@index([url])
  @@index([userid])

}

model Slug {
  id        Int      @id @default(autoincrement())
  slug      String
  url       Int
  validTill DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @onUpdate(now())

  @@index([slug])
}